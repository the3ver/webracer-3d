{
  "name": "webracer-3d",
  "version": "0.2.14",
  "description": "Pine Valley Raceway - 3D Isometric Arcade Circuit Racer with Three.js and Custom 2.5D Physics",
  "type": "module",
  "scripts": {
    "dev": "vite src --port 3000",
    "build": "vite build src --outDir ../dist",
    "preview": "vite preview src --port 3000",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^6.0.0"
  }
}